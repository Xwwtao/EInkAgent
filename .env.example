# Copy the names, not this file: the app reads environment variables only and
# does not load .env files. Set them in the terminal that starts the server.
DEEPSEEK_API_KEY=
# Optional; defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Model judge for evaluation only (docs/decisions/007-llm-judge.md).
# OpenAI-compatible endpoint; pick the one for your Alibaba Cloud region.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional; defaults to qwen3.8-flash.
JUDGE_MODEL=qwen3.8-flash
# Optional; "true" turns on Qwen's thinking mode (about 10x slower).
JUDGE_ENABLE_THINKING=false

# Optional: turns on the search_knowledge tool (docs/decisions/008).
# OpenAI-compatible embedding endpoint; the same DashScope key works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional; defaults to qwen3.7-text-embedding-flash. Must match the model
# that built data/knowledge_index.json.
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Optional: where session memory is stored (docs/decisions/009). Defaults to
# data/memory.db, which Git ignores. Only used when the page sends a session_id.
MEMORY_DB_PATH=
